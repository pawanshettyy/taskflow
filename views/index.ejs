<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TaskFlow &mdash; Smart Task Manager</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <!-- NLP Chatbot integration: floating widget styles (new file, does not touch style.css) -->
  <link rel="stylesheet" href="/css/chat-widget.css" />
</head>
<body>

  <!-- ===== Header / Navbar ===== -->
  <header class="navbar">
    <div class="navbar-inner">
      <div class="brand">
        <span class="brand-mark">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 12.5L9.5 18L20 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        TaskFlow
      </div>
      <nav class="nav-links">
        <a class="active" href="/">List</a>
        <a href="/calendar">Calendar</a>
        <a href="/profile"><%= user.name %></a>
        <form action="/auth/logout" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button type="submit">Log out</button></form>
      </nav>
    </div>
  </header>

  <!-- ===== Hero ===== -->
  <section class="hero">
    <h1>Organize your day.<br />Get things done.</h1>
    <p class="hero-sub">A calm, focused space for the things you need to finish today.</p>
  </section>

  <main class="container">

    <!-- ===== Add Task Form ===== -->
    <form class="add-task-form" action="/tasks" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input
        type="text"
        name="title"
        placeholder="What do you need to do?"
        autocomplete="off"
        required
      />
      <input type="date" name="dueDate" aria-label="Due date" />
      <button type="submit">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
        </svg>
        Add task
      </button>
    </form>

    <!-- ===== Stats + Filters ===== -->
    <div class="toolbar">
      <div class="stat-pills">
        <span class="pill"><strong><%= stats.total %></strong> total</span>
        <span class="pill"><strong><%= stats.active %></strong> active</span>
        <span class="pill"><strong><%= stats.completed %></strong> done</span>
      </div>

      <div class="filters">
        <a href="/?filter=all" class="filter-link <%= filter === 'all' ? 'active' : '' %>">All</a>
        <a href="/?filter=active" class="filter-link <%= filter === 'active' ? 'active' : '' %>">Active</a>
        <a href="/?filter=completed" class="filter-link <%= filter === 'completed' ? 'active' : '' %>">Completed</a>
      </div>
    </div>

    <!-- ===== Task List ===== -->
    <% if (tasks.length === 0) { %>
      <div class="empty-state">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 12l2 2 4-4m5 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <h3>Nothing here yet</h3>
        <p>
          <% if (filter === 'completed') { %>
            You haven't completed any tasks yet.
          <% } else if (filter === 'active') { %>
            You're all caught up &mdash; nice work.
          <% } else { %>
            Add your first task above to get started.
          <% } %>
        </p>
      </div>
    <% } else { %>
      <ul class="task-list">
        <% tasks.forEach(function(task) { %>
          <li class="task-card <%= task.completed ? 'completed' : '' %>">
            <form class="complete-form" action="/tasks/<%= task.id %>/complete" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="check-btn" aria-label="Toggle complete">
                <% if (task.completed) { %>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                <% } %>
              </button>
            </form>

            <span class="task-title"><%= task.title %><% if (task.dueDate) { %><small>Due <%= task.dueDate %></small><% } %></span>

            <details class="task-edit">
              <summary>Edit</summary>
              <form action="/tasks/<%= task.id %>/edit" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="text" name="title" value="<%= task.title %>" aria-label="Task title" required />
                <input type="date" name="dueDate" value="<%= task.dueDate || '' %>" aria-label="Due date" />
                <button type="submit">Save</button>
              </form>
            </details>

            <form class="delete-form" action="/tasks/<%= task.id %>/delete" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="delete-btn" aria-label="Delete task">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 7h16M9 7V5a1 1 0 011-1h4a1 1 0 011 1v2m2 0v13a1 1 0 01-1 1H8a1 1 0 01-1-1V7h10z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </form>
          </li>
        <% }); %>
      </ul>
    <% } %>

  </main>

  <footer class="footer">
    Built with Node.js &amp; Express &mdash; TaskFlow
  </footer>

  <script src="/js/script.js"></script>

  <!-- ===== NLP Chatbot widget (added) =====
       Runs entirely inside a sandboxed iframe pointed at the chatbot's
       own UI, so its HTML/CSS/JS can never collide with anything above. -->
  <div id="chatWidgetRoot">
    <div class="cw-panel">
      <iframe
        title="Support chat"
        data-src="/chatbot-widget/index.html"
        loading="lazy"
      ></iframe>
    </div>
    <button type="button" class="cw-launcher" aria-label="Open chat assistant" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M21 12a8 8 0 1 1-3.4-6.53M21 4v6h-6" stroke="currentColor" stroke-width="0" fill="none"/>
        <path d="M4 12a8 8 0 0 1 8-8c4.42 0 8 3.58 8 8 0 1.3-.31 2.53-.86 3.62L20 20l-4.62-1.14A7.96 7.96 0 0 1 12 20a8 8 0 0 1-8-8Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
  <script src="/js/chat-widget.js"></script>
</body>
</html>
