# Optional settings for the integrated NLP chatbot (/api routes).
# Copy this file to .env and adjust if needed — the app works fine
# with none of these set (sensible defaults are used).

# Node environment (affects morgan log format for /api requests)
NODE_ENV=development

# Rate limiting for /api/*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS origin allowed to call /api/* (default "*")
CORS_ORIGIN=*

# Minimum confidence for the intent classifier before it answers
# instead of falling back to a generic response (0-1)
CONFIDENCE_THRESHOLD=0.12

# How long (ms) a chat session's context is kept in memory
SESSION_TTL_MS=1800000

# Optional Gemini support for concise, natural responses within known intents.
# Leave GEMINI_API_KEY empty to use the local response generator only.
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=8000
